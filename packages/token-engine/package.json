{
    "name": "@blend-design/token-engine",
    "version": "0.1.0",
    "description": "Token resolution engine for Blend Token Studio — transforms brand configs into component tokens (private, bundled into @juspay/blend-design-system)",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "types": "./src/index.ts"
        },
        "./server": {
            "import": "./src/server.ts",
            "types": "./src/server.ts"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts src/server.ts --format esm --dts --external @juspay/blend-design-system",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "@juspay/blend-design-system": ">=0.0.37-0 <1.0.0"
    },
    "devDependencies": {
        "@juspay/blend-design-system": "workspace:*",
        "typescript": "~5.8.3",
        "tsup": "^8.0.0",
        "vitest": "^3.2.4"
    }
}
