{
    "name": "blend-telemetry",
    "version": "0.1.1",
    "description": "Telemetry CLI for @juspay/blend-design-system component usage — language-aware scanner for ReScript and TypeScript projects",
    "bin": {
        "blend-telemetry": "bin/blend-telemetry.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "author": "Deepanshu Rai (deepanshu_juspay)",
    "files": [
        "bin",
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@inquirer/prompts": "^7.5.2",
        "@typescript-eslint/typescript-estree": "^8.32.0",
        "chalk": "^5.4.1",
        "cli-table3": "^0.6.5",
        "commander": "^13.1.0",
        "cosmiconfig": "^9.0.0",
        "fast-glob": "^3.3.3",
        "strip-json-comments": "^5.0.3"
    },
    "devDependencies": {
        "@types/node": "^22.15.2",
        "tsup": "^8.4.0",
        "typescript": "^5.8.3",
        "vitest": "^3.1.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "blend-design-system",
        "telemetry",
        "component-usage",
        "rescript",
        "typescript",
        "design-system"
    ],
    "license": "MIT"
}
