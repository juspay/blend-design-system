# Server Configuration
PORT=3001
NODE_ENV=development

# Database (PostgreSQL) — matches docker-compose.yml
DATABASE_URL=postgresql://blend:blend_secret@localhost:5432/blend_studio

# Database connection tuning (optional)
DB_CONNECTION_LIMIT=3
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_RETRY_DELAY_MS=5000
DB_CONNECT_MAX_ATTEMPTS=6

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# JWT Configuration
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# Short-lived token for Studio → paste into `blend-studio login` (default 10m)
JWT_CLI_EXPORT_EXPIRES_IN=10m

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Google Fonts Developer API (optional — powers GET /api/google-fonts)
# https://console.cloud.google.com/apis/library/googlefonts.googleapis.com
GOOGLE_FONTS_API_KEY=
