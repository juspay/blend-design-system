{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "baseUrl": ".",
        "paths": {
            "@blend-design/token-engine": ["../../packages/token-engine/src/index.ts"],
            "@blend-design/token-engine/server": ["../../packages/token-engine/src/server.ts"]
        }
    },
    "include": ["src", "lib"],
    "references": [{ "path": "./tsconfig.vite.json" }]
}
