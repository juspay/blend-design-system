{
    "name": "@juspay/blend-native",
    "version": "0.0.1-beta.0",
    "description": "React Native components for Blend Design System",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "src"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        }
    },
    "scripts": {
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "@juspay/blend-design-system": ">=0.0.37",
        "expo-linear-gradient": ">=15.0.0",
        "react": ">=18.2.0",
        "react-native": ">=0.74.0"
    },
    "peerDependenciesMeta": {
        "expo-linear-gradient": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@juspay/blend-design-system": "workspace:*",
        "@types/react": "^19.1.17",
        "eslint": "^9.25.0",
        "eslint-import-resolver-typescript": "^3.7.0",
        "eslint-plugin-import-x": "^4.6.1",
        "eslint-plugin-react-hooks": "^5.2.0",
        "expo-linear-gradient": "~15.0.3",
        "react": "19.2.3",
        "react-native": "0.85.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vitest": "^3.2.4"
    },
    "keywords": [
        "react-native",
        "blend",
        "design-system",
        "juspay",
        "ui"
    ],
    "author": "Juspay",
    "license": "MIT",
    "homepage": "https://blend.juspay.design/",
    "repository": {
        "type": "git",
        "url": "https://github.com/juspay/blend-design-system.git"
    },
    "bugs": {
        "url": "https://github.com/juspay/blend-design-system/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@10.21.0"
}
