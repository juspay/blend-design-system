{
    "name": "tokenizer-sandbox",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "token:init": "pnpm exec blend-token-studio init --defaults --force",
        "token:brand": "pnpm exec blend-token-studio brand --preset blend",
        "token:validate": "pnpm exec blend-token-studio validate",
        "token:login": "pnpm exec blend-token-studio login",
        "token:list": "pnpm exec blend-token-studio list",
        "token:pull": "pnpm exec blend-token-studio pull",
        "token:push": "pnpm exec blend-token-studio push"
    },
    "dependencies": {
        "@juspay/blend-design-system": "workspace:*",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "styled-components": "^6.4.0"
    },
    "devDependencies": {
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^4.4.1",
        "blend-token-studio": "workspace:*",
        "typescript": "~5.8.3",
        "vite": "^6.3.5"
    }
}
