# Blend Token Studio — copy to .env (never commit .env)

# ---- Client (Vite; exposed to browser) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Server / Admin SDK (studio API + legacy services) ----
# Use a Firebase service account; private key newlines often escaped as \n in .env
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional if different from default bucket:
# FIREBASE_STORAGE_BUCKET=

# ---- PostgreSQL (users, roles, monitor tables) ----
DATABASE_URL=postgresql://user:password@localhost:5432/blend_studio

# ---- Studio HTTP API ----
STUDIO_API_PORT=3001

# ---- Optional integrations ----
# NPM_API_BASE_URL=https://registry.npmjs.org
# FIGMA_API_TOKEN=
