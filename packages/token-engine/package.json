{
    "name": "@blend-design/token-engine",
    "version": "0.1.0",
    "description": "Token resolution engine for Blend Token Studio — transforms brand configs into component tokens",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./server": {
            "import": "./dist/server.js",
            "types": "./dist/server.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/server.ts --format esm --dts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@juspay/blend-design-system": ">=1.0.0"
    },
    "devDependencies": {
        "@juspay/blend-design-system": "workspace:*",
        "typescript": "~5.8.3",
        "tsup": "^8.0.0",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    }
}
